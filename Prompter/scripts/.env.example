# Copy to Prompter/scripts/.env.local (gitignored) and fill in for local releases.
# Variables already exported in your shell take precedence over this file.

# Developer ID signing identity as listed by: security find-identity -v -p codesigning
SIGNING_IDENTITY="Developer ID Application: <Your Name> (<TEAMID>)"

# Apple Developer team ID (10 characters)
APPLE_TEAM_ID=<TEAMID>

# Notarization, local: the name of a notarytool keychain profile
# (create once with: xcrun notarytool store-credentials <profile-name> --apple-id <apple-id> --team-id <TEAMID>)
NOTARY_PROFILE=<profile-name>

# Needed only to create the keychain profile on first run, or for password-based notarization (CI)
# APPLE_ID=<apple-id-email>
# NOTARY_APP_SPECIFIC_PASSWORD=<app-specific-password>
